{
  "name": "@piqnt/transition",
  "version": "0.0.1",
  "description": "Minimal transition and tweening library",
  "keywords": [
    "transition",
    "tween",
    "animation",
    "easing"
  ],
  "author": "Ali Shakiba",
  "license": "MIT",
  "homepage": "https://github.com/piqnt/transition.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/piqnt/transition.js.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/transition.js",
  "module": "./dist/transition.js",
  "browser": "./dist/transition.umd.js",
  "jsdelivr": "./dist/transition.umd.js",
  "unpkg": "./dist/transition.umd.js",
  "types": "./dist/transition.d.ts",
  "exports": {
    ".": {
      "types": "./dist/transition.d.ts",
      "import": "./dist/transition.js",
      "require": "./dist/transition.cjs"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/node": "^22.10.7",
    "rollup-plugin-license": "^3.5.3",
    "tslib": "^2.8.1",
    "typescript": "^5.6.2",
    "vite": "^6.0.3",
    "vite-plugin-dts-bundle-generator": "^2.0.7",
    "vite-plugin-typescript": "^1.0.4"
  },
  "scripts": {
    "build": "vite build",
    "watch": "vite build --watch",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "change": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  }
}
