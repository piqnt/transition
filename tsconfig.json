{
  "compilerOptions": {
    "esModuleInterop": true,
    "skipLibCheck": true,
    "target": "ES6",
    "allowJs": true,
    "moduleDetection": "force",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,

    "strict": false,

    "module": "ES6",
    "outDir": "dist",
    "sourceMap": true,

    "noEmit": true,

    "lib": ["ES6", "dom"],

    "types": []
  },
  "include": ["src"],
  "exclude": ["dist", "node_modules"]
}
